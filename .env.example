# Runtime mode: local | azure
ACRFP_MODE=local

# LLM provider: mock | openai | anthropic | azure_foundry
# Foundry = deploy a MODEL in Azure AI Foundry, then point this API at it (not Agent Service).
# See README → "Azure AI Foundry" for portal + AKS steps.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Example: https://YOUR-RESOURCE.cognitiveservices.azure.com  (app appends /openai/v1)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=claude-sonnet-4-5

# Service URLs (docker-compose defaults)
GUARDRAIL_URL=http://localhost:8001
EXECUTOR_URL=http://localhost:8002
API_URL=http://localhost:8000

# Approval / safety
AUTO_EXECUTE_LOW_RISK=true
REQUIRE_HUMAN_FOR_MEDIUM=true
DENY_CRITICAL_BY_DEFAULT=true
POLICY_PACK=local

# Optional: Teams/Slack incoming webhook for pending approvals
NOTIFY_WEBHOOK_URL=

# Local mock cluster identity
CLUSTER_NAME=local-dev
CLOUD_PROVIDER=azure
